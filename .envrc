# 1. Set the project root (Works the same on Windows Git Bash)
export JULIA_PROJECT="$PWD"

# 2. Point to the Windows juliaup location
# On Windows, juliaup usually installs to LocalAppData
JULIA_HOME="/c/Users/$USER/AppData/Local/Programs/JuliaUP"

# 3. Add the bin directory to the PATH
PATH_add "$JULIA_HOME/bin"

# 4. Set the julia variables
export JULIA="$JULIA_HOME/bin/julia.exe"
export julia="$JULIA_HOME/bin/julia.exe"